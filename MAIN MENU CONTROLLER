end

-- Play
local function play()
	if not interactive or busy or openPanel or not MenuState.is(S.MENU_ACTIVE) then
		return
	end
	busy = true
	if not MenuState.set(S.TRANSITIONING) then
		busy = false
		return
	end
	setNavEnabled(false)
	MenuAudio.click()
	MenuAudio.transition()
	UIKit.fade(main, false, 0.6)
	UIKit.tween(shade, TweenInfo.new(0.8), { BackgroundTransparency = 1 })

	local pushDone = false
	task.spawn(function()
		MenuCamera.pushToPlay()
		pushDone = true
	end)

	local ok, accepted, reason = pcall(StartGameplay.InvokeServer, StartGameplay, { CharacterId = MenuState.SelectedCharacter })
	if not ok or accepted ~= true then
		-- back to the menu, nothing left half-disabled
		while not pushDone do
			RunService.RenderStepped:Wait()
		end
		MenuState.set(S.MENU_ACTIVE)
		UIKit.fade(main, true, 0.5)
		UIKit.tween(shade, TweenInfo.new(0.6), { BackgroundTransparency = 0 })
		setNavEnabled(true)
		showToast("Could not enter the world: " .. tostring(ok and reason or accepted))
		busy = false
		return
	end

	local character = player.Character or player.CharacterAdded:Wait()
	while not pushDone do
		RunService.RenderStepped:Wait()
	end
	UIKit.tween(overlay, TweenInfo.new(0.35, Enum.EasingStyle.Sine), { BackgroundTransparency = 0 }).Completed:Wait()
	character:WaitForChild("Humanoid", 10)
	MenuState.set(S.GAMEPLAY)
	MenuCamera.handOff(character)
	setCoreUi(true)
	-- controls are on by default for a fresh character; re-enable defensively without yielding
	local playerModule = player:FindFirstChild("PlayerScripts") and player.PlayerScripts:FindFirstChild("PlayerModule")
	if playerModule then
		local ok2, controls = pcall(function()
			return require(playerModule):GetControls()
		end)
		if ok2 and controls then
			controls:Enable()
		end
	end
	UIKit.tween(overlay, TweenInfo.new(0.7, Enum.EasingStyle.Sine), { BackgroundTransparency = 1 }).Completed:Wait()
	gui.Enabled = false
end

