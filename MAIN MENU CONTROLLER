-- State used by controls
local interactive = false
local busy = false
local openPanel: { frame: Frame }? = nil
local panels = {}
local navButtons = {}

local function showToast(text: string)
	toast.Text = text
	UIKit.tween(toast, TweenInfo.new(0.3), { TextTransparency = 0, BackgroundTransparency = 0.25 })
	task.delay(3, function()
		UIKit.tween(toast, TweenInfo.new(0.5), { TextTransparency = 1, BackgroundTransparency = 1 })
	end)
end

local function setNavEnabled(on: boolean)
	for _, b in ipairs(navButtons) do
		b.setEnabled(on)
	end
end

-- Panels
local function closePanel()
	if not openPanel or busy then
		return
	end
	MenuAudio.click()
	local p = openPanel
	openPanel = nil
	UIKit.fade(p.frame, false, 0.22)
	UIKit.tween(p.frame, TweenInfo.new(0.25, Enum.EasingStyle.Quad), { Position = UDim2.new(0, -24, 0.5, 0) })
	task.delay(0.25, function()
		if openPanel ~= p then
			p.frame.Visible = false
		end
	end)
	main.Visible = true
	UIKit.fade(nav, true, 0.3)
	UIKit.fade(footer, true, 0.3)
	UIKit.tween(nav, TweenInfo.new(0.3, Enum.EasingStyle.Quad), { Position = UDim2.fromOffset(0, 262) })
	setNavEnabled(true)
	UIKit.fade(titleBlock, true, 0.3)
	if GuiService.SelectedObject then
		GuiService.SelectedObject = navButtons[1].button
	end
end

local function openPanelNamed(name: string)
	if not interactive or busy or openPanel then
		return
	end
	local p = panels[name]
	if not p then
		return
	end
	MenuAudio.click()
	openPanel = p
	setNavEnabled(false)
	UIKit.fade(nav, false, 0.2)
	UIKit.fade(footer, false, 0.2)
	UIKit.fade(titleBlock, false, 0.2)
	UIKit.tween(nav, TweenInfo.new(0.25, Enum.EasingStyle.Quad), { Position = UDim2.fromOffset(-24, 262) })
	p.frame.Position = UDim2.new(0, 24, 0.5, 0)
	UIKit.setHidden(p.frame)
	p.frame.Visible = true
	UIKit.fade(p.frame, true, 0.35)
	UIKit.tween(p.frame, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { Position = UDim2.new(0, 0, 0.5, 0) })
	if p.onOpen then
		p.onOpen()
	end
	if GuiService.SelectedObject then
		GuiService.SelectedObject = p.back.button
	end
end

