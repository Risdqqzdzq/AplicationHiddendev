	local counter = UIKit.label({ Name = "Counter", Position = UDim2.new(0, 0, 1, -112), Size = UDim2.new(1, 0, 0, 40), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = T.Gold, TextSize = 19, Parent = info })
	local index = 1
	local current: Model? = nil
	local selectBtn
	local function show(i: number)
		index = ((i - 1) % #MenuConfig.Characters) + 1
		local def = MenuConfig.Characters[index]
		if current then
			current:Destroy()
		end
		current = buildFigure(def)
		current.Parent = vp
		nameLabel.Text = def.Name
		desc.Text = def.Description
		counter.Text = string.format("�   %d / %d   �", index, #MenuConfig.Characters)
		selectBtn.setText(MenuState.SelectedCharacter == def.Id and "Selected" or "Select")
	end
	for _, dir in ipairs({ -1, 1 }) do
		local b = new("TextButton", {
			Name = dir < 0 and "Prev" or "Next",
			Position = UDim2.new(dir < 0 and 0 or 1, dir < 0 and 0 or -44, 1, -112),
			Size = UDim2.fromOffset(44, 40),
			BackgroundTransparency = 1,
			Text = "",
			Selectable = true,
			Parent = info,
		})
		b.Activated:Connect(function()
			MenuAudio.click()
			show(index + dir)
		end)
	end
	selectBtn = UIKit.button(info, "Select", {
		height = 50,
		primary = true,
		textSize = 22,
		onActivate = function()
			MenuAudio.click()
			MenuState.SelectedCharacter = MenuConfig.Characters[index].Id
			show(index)
		end,
	})
	selectBtn.holder.AnchorPoint = Vector2.new(0, 1)
	selectBtn.holder.Position = UDim2.fromScale(0, 1)
	selectBtn.holder.Size = UDim2.new(1, 0, 0, 50)
	show(1)
	-- slow turntable while the panel is open
	local spin = 0
	RunService.RenderStepped:Connect(function(dt)
		if openPanel and openPanel.frame == shell.frame and current then
			spin += dt * 0.6
			current:PivotTo(CFrame.Angles(0, math.sin(spin) * 0.7, 0))
		end
	end)
	panels.Characters = { frame = shell.frame, back = shell.back }
end

