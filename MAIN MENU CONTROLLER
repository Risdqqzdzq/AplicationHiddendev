-- Characters
local function buildFigure(def): Model
	local m = Instance.new("Model")
	local c = def.Colors
	local function block(size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?)
		local p = Instance.new("Part")
		p.Anchored = true
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		if shape then
			p.Shape = shape
		end
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = m
		return p
	end
	local boots = Color3.fromRGB(70, 48, 36)
	for _, x in ipairs({ -0.48, 0.48 }) do
		block(Vector3.new(0.8, 2.2, 0.85), CFrame.new(x, 1.3, 0), c.Body:Lerp(Color3.new(0, 0, 0), 0.25))
		block(Vector3.new(0.9, 0.6, 1.1), CFrame.new(x, 0.3, 0.08), boots)
	end
	block(Vector3.new(2.1, 1.0, 1.25), CFrame.new(0, 2.35, 0), c.Body)
	block(Vector3.new(2.0, 2.0, 1.1), CFrame.new(0, 3.6, 0), c.Body)
	block(Vector3.new(2.06, 0.32, 1.16), CFrame.new(0, 2.75, 0), c.Accent, Enum.Material.Leather)
	block(Vector3.new(0.4, 0.4, 0.1), CFrame.new(0, 2.75, 0.6), T.GoldBright, Enum.Material.Metal)
	for _, x in ipairs({ -1.35, 1.35 }) do
		block(Vector3.new(0.7, 1.9, 0.8), CFrame.new(x, 3.5, 0), c.Body)
		block(Vector3.new(0.95, 0.45, 1.0), CFrame.new(x, 4.45, 0), c.Accent, Enum.Material.Metal)
		block(Vector3.new(0.6, 0.6, 0.6), CFrame.new(x, 2.4, 0), c.Skin, nil, Enum.PartType.Ball)
	end
	block(Vector3.new(1.65, 1.65, 1.65), CFrame.new(0, 5.4, 0), c.Skin, nil, Enum.PartType.Ball)
	block(Vector3.new(1.8, 1.8, 1.8), CFrame.new(0, 5.75, -0.22), c.Hair, nil, Enum.PartType.Ball)
	for _, x in ipairs({ -0.3, 0.3 }) do
		block(Vector3.new(0.17, 0.28, 0.05), CFrame.new(x, 5.4, 0.8), Color3.fromRGB(30, 30, 40))
	end
	block(Vector3.new(2.0, 3.4, 0.14), CFrame.new(0, 3.0, -0.68) * CFrame.Angles(0.08, 0, 0), c.Accent:Lerp(c.Body, 0.4), Enum.Material.Fabric)
	m.WorldPivot = CFrame.new() -- pivot at the feet so the turntable keeps the figure grounded
	if def.Gear == "Shield" then
		block(Vector3.new(0.3, 2.6, 2.6), CFrame.new(-1.95, 3.2, 0.35) * CFrame.Angles(0, math.rad(80), 0), c.Body:Lerp(T.Ivory, 0.2), Enum.Material.Metal, Enum.PartType.Cylinder)
		block(Vector3.new(0.34, 1.0, 1.0), CFrame.new(-2.05, 3.2, 0.35) * CFrame.Angles(0, math.rad(80), 0), c.Accent, Enum.Material.Metal, Enum.PartType.Cylinder)
		block(Vector3.new(0.25, 3.2, 0.25), CFrame.new(1.5, 3.0, 0.5) * CFrame.Angles(0.25, 0, 0), Color3.fromRGB(200, 205, 210), Enum.Material.Metal)
	elseif def.Gear == "Staff" then
		block(Vector3.new(0.22, 6.2, 0.22), CFrame.new(1.65, 3.3, 0.35), Color3.fromRGB(120, 84, 56), Enum.Material.Wood)
		local gem = block(Vector3.new(0.75, 0.75, 0.75), CFrame.new(1.65, 6.6, 0.35), c.Accent, Enum.Material.Neon, Enum.PartType.Ball)
		gem.Transparency = 0.1
	else
		for i = -2, 2 do
			local a = i * 0.32
			block(Vector3.new(0.16, 0.9, 0.16), CFrame.new(-1.75, 3.4 + math.sin(a) * 1.7, 0.2 + math.cos(a) * 0.7 - 0.7) * CFrame.Angles(-a, 0, 0), Color3.fromRGB(110, 76, 50), Enum.Material.Wood)
		end
		block(Vector3.new(0.7, 2.2, 0.7), CFrame.new(0.6, 4.0, -0.75) * CFrame.Angles(0, 0, -0.4), c.Accent, Enum.Material.Leather) -- quiver
	end
	return m
end

