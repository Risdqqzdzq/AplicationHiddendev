	local nameLabel = UIKit.label({ Name = "CharName", Size = UDim2.new(1, 0, 0, 64), TextSize = 27, TextWrapped = true, FontFace = Font.new(T.TitleFont.Family, Enum.FontWeight.Bold), TextYAlignment = Enum.TextYAlignment.Top, Parent = info })
