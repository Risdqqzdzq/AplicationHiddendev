		order += 1
		UIKit.label({ Text = entry.Title, Size = UDim2.new(1, 0, 0, 30), TextSize = 23, FontFace = Font.new(T.TitleFont.Family, Enum.FontWeight.Bold), LayoutOrder = order, Parent = list })
		for _, note in ipairs(entry.Notes) do
