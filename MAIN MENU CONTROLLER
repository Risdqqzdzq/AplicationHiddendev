-- Input: Enter plays, Backspace / gamepad B goes back, gamepad gets selection
UserInputService.InputBegan:Connect(function(input, processed)
	if not interactive or busy then
		return
	end
	if input.KeyCode == Enum.KeyCode.ButtonB or (not processed and input.KeyCode == Enum.KeyCode.Backspace) then
		closePanel()
	elseif not processed and (input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.KeypadEnter) and not openPanel and not GuiService.SelectedObject then
		play()
	elseif input.UserInputType == Enum.UserInputType.Gamepad1 and not GuiService.SelectedObject and MenuState.is(S.MENU_ACTIVE) then
		GuiService.SelectedObject = openPanel and (openPanel :: any).back.button or navButtons[1].button
	end
end)

-- Settings persistence (debounced)
local saveToken = 0
MenuState.SettingChanged:Connect(function()
	saveToken += 1
	local token = saveToken
	task.delay(1.2, function()
		if token == saveToken then
			SaveSettings:FireServer(MenuState.getSettings())
		end
	end)
end)

task.spawn(function()
	local ok, data, persistent = pcall(LoadSettings.InvokeServer, LoadSettings)
	local label = panels.Settings.persistLabel
	if ok then
		local before = saveToken
		MenuState.applySettings(data)
		saveToken = before -- applying loaded values is not a user change
		label.Text = persistent and "Settings are saved to your account." or "Settings apply this session only (saving unavailable here)."
	else
		label.Text = "Settings apply this session only (saving unavailable here)."
	end
end)

