-- Responsive layout
local portrait = false
local function layout()
	local vs = camera.ViewportSize
	portrait = vs.Y > vs.X * 1.05
	if portrait then
		uiScale.Scale = math.clamp(vs.X / 620, 0.5, 1.2)
		local s = uiScale.Scale
		main.AnchorPoint = Vector2.new(0.5, 0)
		main.Position = UDim2.new(0.5, 0, 0, 0)
		main.Size = UDim2.fromOffset(480, vs.Y / s)
		titleBlock.Position = UDim2.fromOffset(40, math.max(60, vs.Y / s * 0.07))
		nav.Position = UDim2.new(0, 80, 1, -380)
		footer.Position = UDim2.new(0, 80, 1, -90)
		panelHost.AnchorPoint = Vector2.new(0.5, 0.5)
		panelHost.Position = UDim2.fromScale(0.5, 0.55)
		panelHost.Size = UDim2.fromOffset(560, math.min(640, vs.Y / s - 200))
		shade.Size = UDim2.fromScale(1, 1)
		shadeGradient.Rotation = 90
		shadeGradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.55),
			NumberSequenceKeypoint.new(0.35, 1),
			NumberSequenceKeypoint.new(0.55, 0.85),
			NumberSequenceKeypoint.new(1, 0.3),
		})
	else
		uiScale.Scale = math.clamp(math.min(vs.X / 1600, vs.Y / 900), 0.5, 1.35)
		local s = uiScale.Scale
		local left = math.max(40, vs.X / s * 0.045)
		main.AnchorPoint = Vector2.new(0, 0.5)
		main.Position = UDim2.new(0, left, 0.5, 0)
		main.Size = UDim2.fromOffset(480, 640)
		titleBlock.Position = UDim2.fromOffset(0, 0)
		nav.Position = UDim2.fromOffset(0, 262)
		footer.Position = UDim2.fromOffset(0, 566)
		panelHost.AnchorPoint = Vector2.new(0, 0.5)
		panelHost.Position = UDim2.new(0, left, 0.5, 0)
		panelHost.Size = UDim2.fromOffset(560, math.min(640, vs.Y / s - 40))
		shade.Size = UDim2.fromScale(0.62, 1)
		shadeGradient.Rotation = 0
		shadeGradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.38),
			NumberSequenceKeypoint.new(0.55, 0.78),
			NumberSequenceKeypoint.new(1, 1),
		})
	end
	for _, p in pairs(panels) do
		p.frame.Size = UDim2.new(1, 0, 1, 0)
	end
end
